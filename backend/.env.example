# ===================================================================
# Flick Backend - Environment Configuration Template
# Copy this file to .env and replace placeholders with your values.
# ===================================================================

# Django Settings
DJANGO_SECRET_KEY=your-secure-random-secret-key-min-50-chars
DEBUG=True

# ALLOWED_HOSTS
# In local development (DEBUG=True), localhost, 127.0.0.1, and your active outbound
# LAN IP are automatically detected and permitted.
# In production, specify exact production domains without wildcards:
# ALLOWED_HOSTS=api.yourdomain.com,yourdomain.com
ALLOWED_HOSTS=

# Database Configuration
# Leave blank to use local SQLite (db.sqlite3) during development
DATABASE_URL=

# Third-Party APIs
TMDB_API_KEY=your-tmdb-api-key-here
STREAMING_REGION=IN
ANTHROPIC_API_KEY=your-anthropic-api-key-here
FIREBASE_SERVER_KEY=your-firebase-cloud-messaging-server-key

# OAuth & Social Login
GOOGLE_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.yourcompany.flick

# Security & SSL (Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# CORS & CSRF
# In development (DEBUG=True), localhost, 127.0.0.1, and detected LAN IP origins
# on ports 5173 and 8000 are automatically included.
# In production, specify exact allowed frontend origins:
# CORS_ALLOWED_ORIGINS=https://flick.yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://flick.yourdomain.com
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Redis / Channels (Optional in dev, recommended in multi-worker prod)
# REDIS_URL=redis://localhost:6379/0
