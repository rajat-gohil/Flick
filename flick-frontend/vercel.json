{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/j/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(WhatsApp|facebookexternalhit|Twitterbot|TelegramBot|Applebot|Discordbot|Slackbot|LinkedInBot|SkypeUriPreview|bingpreview).*"
        }
      ],
      "destination": "/api/invite?code=:code"
    },
    {
      "source": "/join/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?i)(WhatsApp|facebookexternalhit|Twitterbot|TelegramBot|Applebot|Discordbot|Slackbot|LinkedInBot|SkypeUriPreview|bingpreview).*"
        }
      ],
      "destination": "/api/invite?code=:code"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
