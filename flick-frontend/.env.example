# =============================================================================
# Flick Frontend — Environment Variables (.env.example)
#
# Configure these variables in your local environment, Vercel Preview,
# or Vercel Production deployment settings.
# =============================================================================

# ── 1. Backend REST API Base URL ─────────────────────────────────────────────
# Points to the Django REST Framework backend API root.
#
# Local Development (Universal Proxy Architecture):
# Leave VITE_API_BASE_URL empty. The Vite dev server automatically proxies
# /api, /ws, /admin, and /healthz to http://127.0.0.1:8000.
# This works seamlessly across Mac localhost and any mobile devices on your Wi-Fi!
VITE_API_BASE_URL=
#
# Vercel Preview (Staging/Branch backend):
# VITE_API_BASE_URL=https://staging-api.yourdomain.com
#
# Vercel Production:
# VITE_API_BASE_URL=https://api.yourdomain.com

# ── 2. Real-Time WebSocket Base URL ─────────────────────────────────────────
# Points to the Django Channels WebSocket endpoint (ws:// or wss://).
#
# Local Development (Universal Proxy Architecture):
# Leave VITE_WS_BASE_URL empty. The client automatically derives the WebSocket
# URL from window.location and connects through Vite's proxy at ws://<current-host>:5173/ws.
VITE_WS_BASE_URL=
#
# Vercel Preview:
# VITE_WS_BASE_URL=wss://staging-api.yourdomain.com
#
# Vercel Production:
# VITE_WS_BASE_URL=wss://api.yourdomain.com

# ── 3. PostHog Product Analytics (Optional) ──────────────────────────────────
# Client-side PostHog project API key and host.
VITE_POSTHOG_KEY=your_posthog_project_key
VITE_POSTHOG_HOST=https://app.posthog.com
